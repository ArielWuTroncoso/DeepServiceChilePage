# ==========================================
# Deep Service Chile - Variables de entorno
# ==========================================

# --- Base de datos ---
# Desarrollo local (H2 en memoria, no requiere instalar nada):
DB_URL=jdbc:h2:mem:deepservice;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# Produccion (PostgreSQL en Render o Neon):
# DB_URL=jdbc:postgresql://HOST:5432/deepservice?sslmode=require
# DB_USER=deepservice
# DB_PASSWORD=cambiar
# DB_DRIVER=org.postgresql.Driver

# --- JPA / Flyway ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
FLYWAY_ENABLED=false

# --- Seguridad JWT ---
# Obligatorio en produccion. Genera uno propio y no lo compartas ni lo subas a GitHub:
#   openssl rand -base64 48
# Si queda vacio el servidor usa una clave al azar que cambia en cada reinicio.
JWT_SECRET=
# Duracion de la sesion del panel (8 horas, en milisegundos).
JWT_EXPIRATION=28800000

# --- Registro de administradores ---
# Codigo que se pide al registrar un administrador. Si queda vacio, el registro
# esta cerrado. Usa uno largo: openssl rand -base64 24
ADMIN_REGISTRO_CODIGO=

# Cuenta inicial opcional: se crea una sola vez si ambos tienen valor. La clave debe tener
# mayuscula, minuscula, numero y simbolo, sin espacios (entre 8 y 72 caracteres).
# No uses una clave conocida: el servidor la rechaza.
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_CLAVE=

# --- CORS: origenes del frontend, separados por coma, sin barra final ---
FRONTEND_ORIGINS=http://localhost:5173,https://deep-service-frontend.onrender.com

# --- Carga automatica del catalogo base (agrega solo los equipos que falten) ---
SEED_ENABLED=true

# --- Puerto ---
PORT=8080

# --- Frontend (Vite) ---
# Vacio si el SPA se sirve embebido en Spring Boot.
# En despliegue separado: https://deep-service-backend.onrender.com
VITE_API_URL=
