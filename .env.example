# ==========================================
# Deep Service Chile - Variables de entorno
# ==========================================

# --- Base de datos ---
# Desarrollo local (H2 en memoria, no requiere instalar nada):
DB_URL=jdbc:h2:mem:deepservice;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# Produccion (PostgreSQL en Render o Neon):
# DB_URL=jdbc:postgresql://HOST:5432/deepservice?sslmode=require
# DB_USER=deepservice
# DB_PASSWORD=cambiar
# DB_DRIVER=org.postgresql.Driver

# --- JPA / Flyway ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
FLYWAY_ENABLED=false

# --- Seguridad JWT ---
JWT_SECRET=6B59703373367639792F423F4528482B4D6251655468576D5A7134743777217A
JWT_EXPIRATION=86400000

# --- CORS: origenes del frontend, separados por coma, sin barra final ---
FRONTEND_ORIGINS=http://localhost:5173,https://deep-service-frontend.onrender.com

# --- Datos de demostracion del catalogo ---
SEED_ENABLED=true

# --- Puerto ---
PORT=8080

# --- Frontend (Vite) ---
# Vacio si el SPA se sirve embebido en Spring Boot.
# En despliegue separado: https://deep-service-backend.onrender.com
VITE_API_URL=
